{"noir_version":"0.36.0+801c71880ecf8386a26737a5d8bb5b4cb164b2ab","hash":6204344618195715565,"abi":{"parameters":[{"name":"workout_count","type":{"kind":"integer","sign":"unsigned","width":32},"visibility":"private"},{"name":"workout_distances","type":{"kind":"array","length":31,"type":{"kind":"integer","sign":"unsigned","width":32}},"visibility":"private"},{"name":"workout_durations","type":{"kind":"array","length":31,"type":{"kind":"integer","sign":"unsigned","width":32}},"visibility":"private"},{"name":"user_id_hash","type":{"kind":"field"},"visibility":"private"},{"name":"month_timestamp","type":{"kind":"field"},"visibility":"public"},{"name":"qualifies","type":{"kind":"boolean"},"visibility":"public"}],"return_type":null,"error_types":{}},"bytecode":"","debug_symbols":"","file_map":{"70":{"source":"global MIN_WORKOUTS: u32 = 12;\nglobal MIN_AVG_DISTANCE: u32 = 5000;\nglobal MIN_TOTAL_DURATION: u32 = 600;\n\nfn main(\n    workout_count: u32,\n    workout_distances: [u32; 31],\n    workout_durations: [u32; 31],\n    user_id_hash: Field,\n    month_timestamp: pub Field,\n    qualifies: pub bool\n) {\n    assert(workout_count >= MIN_WORKOUTS);\n    assert(workout_count <= 31);\n    \n    let mut total_distance: u32 = 0;\n    let mut total_duration: u32 = 0;\n    \n    for i in 0..31 {\n        if i < workout_count {\n            total_distance += workout_distances[i];\n            total_duration += workout_durations[i];\n            \n            assert(workout_distances[i] > 0);\n            assert(workout_distances[i] < 100000);\n            assert(workout_durations[i] > 0);\n            assert(workout_durations[i] < 600);\n        }\n    }\n    \n    assert(total_duration >= MIN_TOTAL_DURATION);\n    \n    let avg_distance = total_distance / workout_count;\n    assert(avg_distance >= MIN_AVG_DISTANCE);\n    \n    assert(user_id_hash != 0);\n    assert(qualifies == true);\n}\n\n#[test]\nfn test_qualifying_workouts() {\n    let mut distances: [u32; 31] = [0; 31];\n    let mut durations: [u32; 31] = [0; 31];\n    \n    for i in 0..15 {\n        distances[i] = 6000;\n        durations[i] = 45;\n    }\n    \n    main(15, distances, durations, 12345, 202412, true);\n}\n\n#[test(should_fail)]\nfn test_insufficient_workouts() {\n    let mut distances: [u32; 31] = [0; 31];\n    let mut durations: [u32; 31] = [0; 31];\n    \n    for i in 0..8 {\n        distances[i] = 6000;\n        durations[i] = 45;\n    }\n    \n    main(8, distances, durations, 12345, 202412, true);\n}\n","path":"/Users/samthomas/proof_of_strava/src/main.nr"}},"names":["main"],"brillig_names":["directive_integer_quotient","directive_invert"]}